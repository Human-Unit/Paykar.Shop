# Demo development configuration. No real secrets.
POSTGRES_DB=paykar
POSTGRES_USER=paykar
POSTGRES_PASSWORD=paykar_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optional local override; component settings safely escape credentials.
# DATABASE_URL=postgresql+asyncpg://paykar:paykar_dev@localhost:5432/paykar
API_HOST=0.0.0.0
API_PORT=8080
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
